# Database
DATABASE_URL=your_database_connection_string_here
# Database timeouts (milliseconds; all optional -- invalid values are ignored with a boot warning and the default is used).
# DB_CONNECT_TIMEOUT_MS: max wait to obtain a connection (new connection handshake or a free pooled one). Default 15000, range 1000-120000.
# DB_CONNECT_TIMEOUT_MS=15000
# DB_STATEMENT_TIMEOUT_MS: OPT-IN server-side statement timeout per connection. Default 0 (off), range 1000-600000. Does not work through poolers
# that reject session SET; leave unset unless you have measured a need.
# DB_STATEMENT_TIMEOUT_MS=0
# AUTH_LOOKUP_TIMEOUT_MS: bound on the read-only session lookup behind every authenticated request. Default 8000, range 1000-60000.
# AUTH_LOOKUP_TIMEOUT_MS=8000

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
APP_URL=http://localhost:5000

# Browser origins (CORS + Socket.IO). Credentialed cross-origin browser requests are allowed ONLY from an explicit allowlist, and nothing
# is allowed when nothing is configured (a missing CLIENT_URL denies cross-origin browser access; it never opens it). The allowlist is:
#   CLIENT_URL, APP_BASE_URL, APP_URL   this application's own public URL(s). In production they must be https and not localhost.
#   CORS_ALLOWED_ORIGINS                extra approved origins, comma separated, e.g. a mobile web view: capacitor://localhost
#   CORS_DEV_ORIGINS                    development origins, comma separated, e.g. http://localhost:5173. Honoured ONLY when
#                                       NODE_ENV is "development" or "test"; ignored (with a startup warning) in production.
# Wildcards ("*"), "null", paths and credentials in a value are rejected. Same-origin traffic, server-to-server webhooks and OAuth
# redirects do not depend on any of this.
# CORS_ALLOWED_ORIGINS=
# CORS_DEV_ORIGINS=http://localhost:5173
#
# Same-origin (Socket.IO, and the Square-connection / invoice-payment POST gate) means the FULL origin: scheme + host + port. A page on
# http://chefsire.com or capacitor://chefsire.com is never "the same origin" as https://chefsire.com. The server reconstructs its own origin from the Host
# header and the scheme established by (1) TLS terminated in this process, or (2) X-Forwarded-Proto, honoured ONLY from a trusted reverse proxy (TRUST_PROXY
# below) and only as one unambiguous value (a list, or several header lines, means "unknown"). In production an http scheme is never accepted as the site's own, and when the scheme cannot be established the
# answer is "unknown" and ONLY the allowlist above admits an origin. So: set CLIENT_URL (or APP_URL) to the public https origin; that always works.
#
# Which peer is a trusted reverse proxy. Default 1 (the direct peer is the proxy: nginx/Passenger on the same host, or a Unix socket). Also governs req.ip.
#   TRUST_PROXY=1               one hop (default, unchanged)             TRUST_PROXY=false        trust no forwarded header
#   TRUST_PROXY=loopback        a TCP upstream on 127.0.0.1/::1 only. NOT for Phusion Passenger: its Unix-socket peer has no address, so every
#                               forwarded header would be ignored and req.ip would be undefined.
#   TRUST_PROXY=10.0.0.0/8      listed addresses/CIDRs/loopback/linklocal/uniquelocal
# "true", "all", "*" and anything unparsable stop the server from starting. Make sure plain http cannot reach the app (redirect http to https at the proxy):
# behind Passenger a plain-http request with a client-typed "X-Forwarded-Proto: https" is indistinguishable from a TLS one.
# TRUST_PROXY=1

# JWT Secret — REQUIRED in production.
# The server refuses to start with NODE_ENV=production (or any NODE_ENV it does not recognise as
# "development"/"test") unless this is a private, random value of at least 32 characters. The
# placeholders below are deliberately rejected: generate your own with `openssl rand -base64 48`.
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Facebook OAuth (optional)
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# TikTok OAuth (optional)
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_CALLBACK_URL=http://localhost:5000/api/auth/tiktok/callback

# Google Maps API (for BiteMap feature and Wedding Planning)
# Note: Get your API key from https://console.cloud.google.com/google/maps-apis
# Make sure to enable both "Maps JavaScript API" and "Places API"
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Client-side version (exposed to browser via Vite)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Email Service (for verification emails)
# For Gmail: Use smtp.gmail.com with an App Password (not your regular password)
# For other providers: Update MAIL_HOST accordingly (e.g., smtp.ionos.com)
MAIL_HOST=smtp.ionos.com
MAIL_PORT=587
MAIL_USER=verify@notify.chefsire.com
MAIL_PASS=your-verification-email-password-here
MAIL_FROM=ChefSire Royal Guard <verify@notify.chefsire.com>

# Wedding Invitation Email Service (separate from verification emails)
# If not provided, will fall back to using the main MAIL_* credentials above
WEDDING_MAIL_HOST=smtp.ionos.com
WEDDING_MAIL_PORT=587
WEDDING_MAIL_USER=invitations@chefsire.com
WEDDING_MAIL_PASS=your-wedding-email-password-here
WEDDING_MAIL_FROM=ChefSire Weddings <invitations@chefsire.com>
# Optional: Reply-To address for guest responses (if not set, replies go to FROM address)
WEDDING_REPLY_TO=rsvp@chefsire.com

# Square provider connection (Phase 2Q Gate 0). Names only: never commit real values.
# SQUARE_ENV selects the environment for EVERY Square integration (API, OAuth authorize host, checkout, webhooks, reconciliation).
# It must be exactly "sandbox" or "production". Unset is Sandbox outside NODE_ENV=production and a configuration error under it;
# any other value is an error. LIVE ("production") additionally requires NODE_ENV=production AND SQUARE_LIVE_PAYMENTS_ENABLED=true.
# Catering is Sandbox-only regardless.
SQUARE_ENV=sandbox
# Leave unset until a deliberate go-live. Only the exact value "true" (with SQUARE_ENV=production and NODE_ENV=production) enables LIVE.
# SQUARE_LIVE_PAYMENTS_ENABLED=
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
# REQUIRED to store any Square OAuth token. Exactly 32 random bytes, base64 (generate: openssl rand -base64 32).
# Without a valid key, connecting Square and every connection check fail closed; there is no plaintext fallback.
SQUARE_OAUTH_TOKEN_ENCRYPTION_KEY=
# Optional, decrypt-only: the previous key during a rotation.
SQUARE_OAUTH_TOKEN_ENCRYPTION_KEY_PREVIOUS=

# --- Catering Phase 2Q: Square SANDBOX customer payments (Catering money settles to the PROVIDER's own connected Square account) ---
# SANDBOX ONLY in this phase: Catering payments are refused unless SQUARE_ENV=sandbox. Production Square is a separate, later launch step.
# Register this exact URL as a webhook subscription in the Square Developer Dashboard (sandbox) for payment.created, payment.updated,
# order.created and order.updated, and put that subscription's signature key below. Both are required; there is no default, and
# the URL is never derived from a request.
SQUARE_CATERING_WEBHOOK_NOTIFICATION_URL=
SQUARE_CATERING_WEBHOOK_SIGNATURE_KEY=

# --- Wedding Square SANDBOX webhook intake (separate from Catering; DISABLED by default) ---
# Requires SQUARE_ENV=sandbox and WEDDING_SQUARE_SANDBOX_ENROLLMENT_ENABLED=true.
# Register the EXACT HTTPS URL below in Square's sandbox webhook settings:
# https://chefsire.com/api/wedding/subscription/webhooks/square
# This is only durable pending-event intake, NOT billing activation or paid evidence.
# The reviewed docs/sql-pending/wedding_square_billing_foundation.sql.txt includes
# wedding_square_webhook_events; until that migration is approved and applied, leave
# the flag OFF. Never reuse the Catering webhook signing key.
# WEDDING_SQUARE_SANDBOX_WEBHOOK_ENABLED=
# WEDDING_SQUARE_SANDBOX_MERCHANT_ID=
WEDDING_SQUARE_WEBHOOK_NOTIFICATION_URL=
WEDDING_SQUARE_WEBHOOK_SIGNATURE_KEY=

# --- Wedding Square sandbox authenticated submission (OFF by default) ---
# Enables ONLY the user-authenticated POST /api/wedding/subscription/sandbox/submit.
# Requires SQUARE_ENV=sandbox, WEDDING_SQUARE_SANDBOX_ENROLLMENT_ENABLED=true,
# an already owner-bound reserved Neon attempt, a verified enabled Square sandbox card,
# and exact first-party HTTPS Origin. Still NEVER grants paid entitlement.
# Enable only after reviewing the full sandbox checkout and reconciliation workflow.
WEDDING_SQUARE_SANDBOX_SUBMIT_ENABLED=
WEDDING_SQUARE_ALLOWED_ORIGIN=

# Wedding Square: sandbox-only, owner-initiated cancel at end of billing period.
# Requires separate sandbox enrollment flag, exact HTTPS first-party origin,
# dedicated platform Square merchant/location and a verified saved subscription.
# Never enable production billing with this flag. Default OFF.
WEDDING_SQUARE_SANDBOX_CANCEL_ENABLED=

# Wedding Square authoritative paid access switch (OFF by default).
# Enable only after end-to-end invoice amount, coverage, refund and dispute
# reconciliation has been verified. Never rely on legacy wedding_tier fields.
WEDDING_SQUARE_VERIFIED_PAID_ENTITLEMENTS_ENABLED=
